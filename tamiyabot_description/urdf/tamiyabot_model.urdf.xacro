<?xml version="1.0" ?>
<robot name="tamiyabot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="is_sim" default="true"/>

  <xacro:include filename="$(find tamiyabot_description)/urdf/tamiyabot_gazebo.xacro"/>
  <xacro:include filename="$(find tamiyabot_description)/urdf/ros2_controller.xacro"/>
  <!-- <xacro:include filename="$(find tamiyabot_description)/urdf/camera.xacro"/> -->
  <!-- <xacro:include filename="$(find tamiyabot_description)/urdf/lidar.xacro"/> -->
  
  <xacro:property name="PI" value="3.1415926535897931" />
  <xacro:property name="base_mass" value="8.0" /> <!-- arbitrary value for base mass -->
  <xacro:property name="base_length" value="1.0" />
  <xacro:property name="base_width" value="0.53" />
  <xacro:property name="base_height" value="0.32" />
  <xacro:property name="wheel_mass" value="0.1" /> <!-- arbitrary value for wheel mass -->
  <xacro:property name="wheelbase" value="0.46" />
  <xacro:property name="wheel_len" value="0.08" />
  <xacro:property name="wheel_radius" value="0.047" />

  <material name="yellow">
    <color rgba="0.700 0.700 0.0 1.000"/>
  </material>

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.000"/>
  </material>

<link name="base_footprint"/>

<link name="base_link">
  <inertial>
    <origin xyz="-0.010832508707129422 -0.0319999966499438 0.07339904454848215" rpy="0 0 0"/>
    <mass value="37.13312619630159"/>
    <inertia ixx="0.16987923440449046" iyy="0.3219956854189482" izz="0.3110549539990225" ixy="-5.542446526035638e-09" iyz="8.55484284800756e-09" ixz="-0.054011183378953734"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="yellow"/>
    <material/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="rear_left_wheel1">
  <inertial>
    <origin xyz="3.21118288182376e-07 0.021000000000005174 9.71445146547012e-17" rpy="0 0 0"/>
    <mass value="1.8054843658150816"/>
    <inertia ixx="0.0010476743842937593" iyy="0.0015752996272435787" izz="0.0010476743842937758" ixy="8.673617379884035e-18" iyz="2.0599841277224584e-18" ixz="2.6020852139652106e-18"/>
  </inertial>
  <visual>
    <origin xyz="0.234009 -0.0155 0.013" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/rear_left_wheel1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="black"/>
    <material/>
  </visual>
  <collision>
    <origin xyz="0.234009 -0.0155 0.013" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/rear_left_wheel1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="rear_right_wheel1">
  <inertial>
    <origin xyz="3.211182857398853e-07 -0.020999999999994814 9.8879238130678e-17" rpy="0 0 0"/>
    <mass value="1.8054843658150797"/>
    <inertia ixx="0.001047674384293762" iyy="0.0015752996272436204" izz="0.0010476743842938174" ixy="0.0" iyz="3.0357660829594124e-18" ixz="4.336808689942018e-18"/>
  </inertial>
  <visual>
    <origin xyz="0.234009 0.0795 0.013" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/rear_right_wheel1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="black"/>
    <material/>
  </visual>
  <collision>
    <origin xyz="0.234009 0.0795 0.013" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/rear_right_wheel1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="steering_right_link1">
  <inertial>
    <origin xyz="3.2111835662068655e-07 0.0001708440293172464 0.003999999971336172" rpy="0 0 0"/>
    <mass value="0.0031874991762403456"/>
    <inertia ixx="6.951495375837513e-08" iyy="2.9377757708371727e-08" izz="7.177559136720569e-08" ixy="1.514494909690689e-18" iyz="-6.094884864274626e-16" ixz="6.352747104407253e-22"/>
  </inertial>
  <visual>
    <origin xyz="-0.029991 0.1005 0.017" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/steering_right_link1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="black"/>
    <material/>
  </visual>
  <collision>
    <origin xyz="-0.029991 0.1005 0.017" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/steering_right_link1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="front_right_wheel1">
  <inertial>
    <origin xyz="3.2111828563233247e-07 -0.01046581392999707 1.5959455978986625e-16" rpy="0 0 0"/>
    <mass value="0.9105437032741225"/>
    <inertia ixx="0.0004316099354611056" iyy="0.000796368727658819" izz="0.0004316121960988347" ixy="7.37257477290143e-18" iyz="2.168404344971009e-18" ixz="5.800481622797449e-18"/>
  </inertial>
  <visual>
    <origin xyz="-0.029991 0.1005 0.013" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/front_right_wheel1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="black"/>
    <material/>
  </visual>
  <collision>
    <origin xyz="-0.029991 0.1005 0.013" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/front_right_wheel1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="steering_left_link1">
  <inertial>
    <origin xyz="3.211183591360356e-07 -0.000170844029316497 0.003999999971336172" rpy="0 0 0"/>
    <mass value="0.003187499176240344"/>
    <inertia ixx="6.951495375835819e-08" iyy="2.937775770836961e-08" izz="7.177559136719891e-08" ixy="-1.508989195533536e-18" iyz="6.09488062910989e-16" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.029991 -0.0365 0.017" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/steering_left_link1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="black"/>
    <material/>
  </visual>
  <collision>
    <origin xyz="-0.029991 -0.0365 0.017" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/steering_left_link1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="front_left_wheel1">
  <inertial>
    <origin xyz="3.2111828832809275e-07 0.010465813929997764 1.734723475976807e-18" rpy="0 0 0"/>
    <mass value="0.9105437032741228"/>
    <inertia ixx="0.0004316099354611104" iyy="0.0007963687276588275" izz="0.00043161219609884295" ixy="7.37257477290143e-18" iyz="-1.0842021724855044e-19" ixz="-7.589415207398531e-19"/>
  </inertial>
  <visual>
    <origin xyz="-0.029991 -0.0365 0.013" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/front_left_wheel1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="black"/>
    <material/>
  </visual>
  <collision>
    <origin xyz="-0.029991 -0.0365 0.013" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/front_left_wheel1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="Camera11">
  <inertial>
    <origin xyz="-0.01999967888171309 -2.220446049250313e-16 0.020000000000000018" rpy="0 0 0"/>
    <mass value="0.2354999999999996"/>
    <inertia ixx="0.0001182406250000035" iyy="1.5700000000003905e-05" izz="0.0001182406249999996" ixy="-1.8973538018496328e-18" iyz="4.336808689942018e-19" ixz="4.336808689942018e-19"/>
  </inertial>
  <visual>
    <origin xyz="-0.079991 0.032 -0.162" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/Camera11.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="black"/>
    <material/>
  </visual>
  <collision>
    <origin xyz="-0.079991 0.032 -0.162" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tamiyabot_description/meshes/Camera11.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<!-- rear wheels -->
<!-- virtual rear wheel -->
<link name="virtual_rear_wheel">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="${PI/2} 0 0" />
        <geometry>
            <cylinder length="0.01" radius="${wheel_radius}" />
        </geometry>
        <material name="blue" />
    </visual>
    <inertial>
    <mass value="0.1"/>  <!-- Adjust mass as needed -->
    <inertia
      ixx="0.001" ixy="0.0" ixz="0.0"
      iyy="0.001" iyz="0.0"
      izz="0.001"/>
  </inertial>
</link>
<joint name="virtual_rear_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="virtual_rear_wheel" />
    <origin xyz="-0.234009 -0.032 -0.013" rpy="0 0 0" />
    <axis xyz="0 1.0 0" />
    <limit effort="100.0" velocity="100.0" />
    <!-- <dynamics damping="0.2" /> -->
</joint>

<!-- front wheels -->
<!-- virtual front wheel -->
<link name="virtual_front_wheel">
    <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0.0" />
        <geometry>
            <cylinder length="0.01" radius="${wheel_radius}" />
        </geometry>
        <material name="blue" />
    </visual>
    <inertial>
    <mass value="0.1"/>  <!-- Adjust mass as needed -->
    <inertia
      ixx="0.001" ixy="0.0" ixz="0.0"
      iyy="0.001" iyz="0.0"
      izz="0.001"/>
  </inertial>
</link>
<joint name="virtual_front_wheel_joint" type="revolute">
    <parent link="base_link" />
    <child link="virtual_front_wheel" />
    <origin xyz="0.029991 -0.032 -0.017" rpy="0 0 0.0" />
    <axis xyz="0 0 -1" />
    <limit lower="-0.3488" upper="0.3488" effort="100.0" velocity="0.0" />
    <!-- <dynamics damping="0.2" /> -->
</joint>
<!-- Define the joints -->
<joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
</joint>
<joint name="rear_left_wheel_joint" type="continuous">
  <origin xyz="-0.234009 0.0155 -0.013" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rear_left_wheel1"/>
  <axis xyz="0.0 1.0 0.0"/>
  <mimic joint="virtual_rear_wheel_joint" multiplier="1.0" offset="0.0" />
</joint>

<joint name="rear_right_wheel_joint" type="continuous">
  <origin xyz="-0.234009 -0.0795 -0.013" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rear_right_wheel1"/>
  <axis xyz="0.0 1.0 0.0"/>
  <mimic joint="virtual_rear_wheel_joint" multiplier="1.0" offset="0.0" />
</joint>

<joint name="front_right_steering_joint" type="revolute">
  <origin xyz="0.029991 -0.1005 -0.017" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="steering_right_link1"/>
  <axis xyz="0.0 0.0 -1.0"/>
  <limit upper="0.785398" lower="-0.785398" effort="100000" velocity="30"/>
  <mimic joint="virtual_front_wheel_joint" multiplier="1.0" offset="0.0" />
</joint>

<joint name="front_left_steering_joint" type="revolute">
  <origin xyz="0.029991 0.0365 -0.017" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="steering_left_link1"/>
  <axis xyz="0.0 0.0 -1.0"/>
  <limit upper="0.785398" lower="-0.785398" effort="100000" velocity="30"/>
  <mimic joint="virtual_front_wheel_joint" multiplier="1.0" offset="0.0" />
</joint>

<joint name="front_right_wheel_joint" type="continuous">
  <origin xyz="0.0 0.0 0.004" rpy="0 0 0"/>
  <parent link="steering_right_link1"/>
  <child link="front_right_wheel1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="front_left_wheel_joint" type="continuous">
  <origin xyz="0.0 0.0 0.004" rpy="0 0 0"/>
  <parent link="steering_left_link1"/>
  <child link="front_left_wheel1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="camera_joint" type="fixed">
  <origin xyz="0.079991 -0.032 0.162" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Camera11"/>
</joint>

</robot>