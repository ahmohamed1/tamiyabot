<!-- Define the joints -->
<joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
</joint>

<joint name="rear_left_wheel_joint" type="continuous">
  <origin xyz="-0.234009 0.06 -0.013" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rear_left_wheel1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="rear_right_wheel_joint" type="continuous">
  <origin xyz="-0.234009 -0.06 -0.013" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rear_right_wheel1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="right_wheel_steering_joint" type="revolute">
  <origin xyz="0.028 -0.06 -0.017" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="steering_right_link1"/>
  <axis xyz="0.0 0.0 -1.0"/>
  <limit upper="0.785398" lower="-0.785398" effort="100" velocity="30"/>
</joint>

<joint name="left_wheel_steering_joint" type="revolute">
  <origin xyz="0.028 0.06 -0.017" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="steering_left_link1"/>
  <axis xyz="0.0 0.0 -1.0"/>
  <limit upper="0.785398" lower="-0.785398" effort="100" velocity="30"/>
</joint>

<joint name="front_right_wheel_joint" type="continuous">
  <origin xyz="0.0 0.0 0.004" rpy="0 0 0"/>
  <parent link="steering_right_link1"/>
  <child link="front_right_wheel1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="front_left_wheel_joint" type="continuous">
  <origin xyz="0.0 0.0 0.004" rpy="0 0 0"/>
  <parent link="steering_left_link1"/>
  <child link="front_left_wheel1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="camera_joint" type="fixed">
  <origin xyz="0.079991 0.0 0.162" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Camera11"/>
</joint>

</robot>
